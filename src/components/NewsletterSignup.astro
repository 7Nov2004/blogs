---
interface Props {
  variant?: 'inline' | 'fullwidth' | 'popup';
}
const { variant = 'fullwidth' } = Astro.props;

const isFullWidth = variant === 'fullwidth';
---

{isFullWidth ? (
  <section class="w-full bg-gradient-to-r from-primary-600 to-accent-600 py-16 px-6 text-white text-center rounded-3xl my-10 shadow-lg">
    <div class="max-w-2xl mx-auto">
      <div class="text-4xl mb-4">📬</div>
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Tech Updates Seedha Inbox Mein!</h2>
      <p class="text-lg text-white/90 mb-8">
        Har hafta latest AI news, coding tips, aur gadget reviews. Join karo 1,000+ tech lovers!
      </p>
      
      <form class="newsletter-form flex flex-col sm:flex-row gap-3 max-w-lg mx-auto">
        <input 
          type="email" 
          placeholder="apna@email.com" 
          required
          class="flex-1 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white/50"
        />
        <button 
          type="submit" 
          class="bg-white text-primary-600 font-bold px-6 py-3 rounded-xl hover:bg-gray-50 transition-colors shadow-sm"
        >
          Subscribe Karo 🚀
        </button>
      </form>
      <p class="newsletter-success hidden text-sm font-semibold text-yellow-200 mt-4">
        🎉 Shukriya! Aap TechVerse newsletter me jud chuke hain!
      </p>
      <p class="text-sm text-white/80 mt-4 flex items-center justify-center gap-1">
        ✅ No spam, sirf quality content. Kabhi bhi unsubscribe kar sakte ho.
      </p>
    </div>
  </section>
) : (
  <div class="card p-8 bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 my-8 text-center">
    <div class="text-3xl mb-3">📬</div>
    <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Tech Updates Seedha Inbox Mein!</h3>
    <p class="text-gray-600 dark:text-gray-300 mb-6">
      Har hafta latest AI news, coding tips, aur gadget reviews. Join karo 1,000+ tech lovers!
    </p>
    
    <form class="newsletter-form flex flex-col gap-3">
      <input 
        type="email" 
        placeholder="apna@email.com" 
        required
        class="w-full rounded-xl px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500"
      />
      <button 
        type="submit" 
        class="btn-primary w-full bg-primary-600 hover:bg-primary-700 text-white font-bold px-6 py-3 rounded-xl transition-colors shadow-sm"
      >
        Subscribe Karo 🚀
      </button>
    </form>
    <p class="newsletter-success hidden text-sm font-semibold text-green-600 dark:text-green-400 mt-4">
      🎉 Shukriya! Aap TechVerse newsletter me jud chuke hain!
    </p>
    <p class="text-xs text-gray-500 dark:text-gray-400 mt-4 flex items-center justify-center gap-1">
      ✅ No spam, sirf quality content. Kabhi bhi unsubscribe kar sakte ho.
    </p>
  </div>
)}

<script is:inline>
  document.querySelectorAll('.newsletter-form').forEach(form => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const parent = form.parentElement;
      const emailInput = form.querySelector('input[type="email"]');
      const submitBtn = form.querySelector('button[type="submit"]');
      const successMsg = parent.querySelector('.newsletter-success');
      const emailVal = emailInput ? emailInput.value : '';

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Subscribing... ⏳';
      }

      try {
        await fetch("https://formsubmit.co/ajax/aayush74550@gmail.com", {
          method: "POST",
          headers: { 
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            Subscriber_Email: emailVal,
            _subject: `[TechVerse] Naya Newsletter Subscriber: ${emailVal}`
          })
        });
      } catch (err) {
        console.error(err);
      } finally {
        if (successMsg) {
          successMsg.classList.remove('hidden');
          form.reset();
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerText = 'Subscribe Karo 🚀';
          }
          setTimeout(() => {
            successMsg.classList.add('hidden');
          }, 8000);
        }
      }
    });
  });
</script>
