---
import AdSlot from './AdSlot.astro';

interface Props {
  slot?: 'header' | 'sidebar' | 'in-article' | 'footer';
  format?: 'auto' | 'horizontal' | 'vertical' | 'rectangle';
}
const { slot = 'in-article', format = 'auto' } = Astro.props;

const positionMap: Record<string, 'top' | 'mid-article' | 'bottom' | 'sidebar'> = {
  'header': 'top',
  'in-article': 'mid-article',
  'sidebar': 'sidebar',
  'footer': 'bottom',
};

const position = positionMap[slot] || 'mid-article';
---

<AdSlot position={position} format={format === 'vertical' ? 'rectangle' : format} />

