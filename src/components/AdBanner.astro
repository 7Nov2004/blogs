---
interface Props {
  slot?: 'header' | 'sidebar' | 'in-article' | 'footer';
  format?: 'auto' | 'horizontal' | 'vertical' | 'rectangle';
}
const { slot = 'in-article', format = 'auto' } = Astro.props;

// AdSense approval status: false rakhne se site clean dikhti hai aur Google "under construction" penalty nahi deta.
// Approval milne ke baad ise true karein.
const showAds = false;
---

{showAds ? (
  <div class="w-full my-6 flex items-center justify-center overflow-hidden">
    <ins class="adsbygoogle"
      style="display:block"
      data-ad-client="ca-pub-3255404615799871"
      data-ad-slot="XXXXX"
      data-ad-format={format}
      data-full-width-responsive="true"></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
) : null}

