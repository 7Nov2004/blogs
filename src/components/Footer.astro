---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 text-gray-300 mt-20 border-t border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <!-- 4-Column Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      
      <!-- Column 1: About -->
      <div>
        <a href="/" class="flex items-center gap-2.5 mb-4 group">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-purple-600 flex items-center justify-center text-white font-extrabold text-lg shadow-md">
            ⚡
          </div>
          <span class="text-2xl font-black tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-blue-400 via-indigo-300 to-purple-400">
            TechVerse
          </span>
        </a>
        <p class="text-gray-400 text-sm leading-relaxed mb-4">
          Tech ki duniya, Hinglish mein! Latest AI tools, gadget reviews, coding roadmaps aur smart digital tips.
        </p>
        <p class="text-xs text-slate-500 font-medium">Made with ❤️ for Indian Tech Lovers.</p>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h3 class="text-white font-semibold mb-4 uppercase tracking-wider text-sm">Quick Links</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-primary-400 transition-colors">Home</a></li>
          <li><a href="/blog" class="hover:text-primary-400 transition-colors">All Blogs</a></li>
          <li><a href="/about" class="hover:text-primary-400 transition-colors">About</a></li>
          <li><a href="/contact" class="hover:text-primary-400 transition-colors">Contact</a></li>
          <li><a href="/privacy" class="hover:text-primary-400 transition-colors">Privacy Policy</a></li>
          <li><a href="/disclaimer" class="hover:text-primary-400 transition-colors">Disclaimer</a></li>
          <li><a href="/rss.xml" class="hover:text-primary-400 transition-colors">RSS Feed</a></li>
        </ul>
      </div>

      <!-- Column 3: Categories -->
      <div>
        <h3 class="text-white font-semibold mb-4 uppercase tracking-wider text-sm">Categories</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/category/ai" class="hover:text-primary-400 transition-colors">AI & ML</a></li>
          <li><a href="/category/webdev" class="hover:text-primary-400 transition-colors">Web Dev</a></li>
          <li><a href="/category/gadgets" class="hover:text-primary-400 transition-colors">Gadgets</a></li>
          <li><a href="/category/tips" class="hover:text-primary-400 transition-colors">Tips & Tricks</a></li>
        </ul>
      </div>

      <!-- Column 4: Newsletter -->
      <div>
        <h3 class="text-white font-semibold mb-4 uppercase tracking-wider text-sm">Newsletter Subscribe Karo!</h3>
        <p class="text-gray-400 text-sm mb-4">
          Har hafta tech updates seedha inbox mein!
        </p>
        <form id="footer-newsletter-form" class="flex flex-col space-y-2">
          <input 
            type="email" 
            id="footer-newsletter-email"
            placeholder="Aapka email address" 
            class="px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-sm text-white focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500"
            required
          />
          <button 
            type="submit" 
            class="px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium rounded-md transition-colors"
          >
            Subscribe
          </button>
          <p id="footer-newsletter-msg" class="text-xs text-green-400 hidden pt-1">✅ Shukriya! Subscribe ho gaya.</p>
        </form>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-gray-800 flex flex-col md:flex-row items-center justify-between">
      <div class="text-gray-400 text-sm flex items-center space-x-1">
        <span>© {currentYear} TechVerse. Made with</span>
        <span class="text-red-500">❤️</span>
        <span>in India</span>
      </div>
      
      <div class="flex items-center space-x-4 mt-4 md:mt-0">
        <a href="/contact" class="text-sm text-gray-400 hover:text-primary-400 transition-colors mr-2">
          Advertise With Us
        </a>
        
        <!-- Social Icons -->
        <a href="mailto:aayush74550@gmail.com" class="text-gray-400 hover:text-white transition-colors" aria-label="Email" title="Email TechVerse">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"></path>
          </svg>
        </a>
        <a href="https://github.com/7Nov2004" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors" aria-label="GitHub" title="GitHub">
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
          </svg>
        </a>
        <a href="/rss.xml" class="text-gray-400 hover:text-white transition-colors" aria-label="RSS Feed" title="RSS Feed">
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.18 15.64a2.18 2.18 0 1 1-2.18 2.18 2.18 2.18 0 0 1 2.18-2.18m-4-7.64v3a8.82 8.82 0 0 1 8.82 8.82h3A11.82 11.82 0 0 0 2.18 8m0-6v3a14.82 14.82 0 0 1 14.82 14.82h3A17.82 17.82 0 0 0 2.18 2z"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  const footerForm = document.getElementById('footer-newsletter-form');
  const footerMsg = document.getElementById('footer-newsletter-msg');
  const footerEmail = document.getElementById('footer-newsletter-email');
  if (footerForm && footerMsg) {
    footerForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailVal = footerEmail ? footerEmail.value : '';
      footerMsg.innerText = 'Subscribing... ⏳';
      footerMsg.classList.remove('hidden');

      try {
        await fetch("https://formsubmit.co/ajax/aayush74550@gmail.com", {
          method: "POST",
          headers: { 
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            Subscriber_Email: emailVal,
            _subject: `[TechVerse] Naya Footer Newsletter Subscriber: ${emailVal}`
          })
        });
      } catch (err) {
        console.error(err);
      } finally {
        footerMsg.innerText = '✅ Shukriya! Subscribe ho gaya.';
        footerForm.reset();
        setTimeout(() => {
          footerMsg.classList.add('hidden');
        }, 6000);
      }
    });
  }
</script>
