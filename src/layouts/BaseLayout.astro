---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  category?: string;
  tags?: string[];
}

const { 
  title, 
  description, 
  image = '/og-default.png', 
  article = false,
  pubDate,
  updatedDate,
  author = 'TechVerse Team',
  category,
  tags = [],
} = Astro.props;

const siteUrl = Astro.site || 'https://techverseblogs.in';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(image, siteUrl);

// WebSite schema (always present)
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "TechVerse",
  "url": siteUrl.toString(),
  "description": "Tech ki Duniya, Hinglish Mein! Latest AI updates, coding tutorials, gadget reviews aur tech tips.",
  "inLanguage": "hi",
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteUrl}blog?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};

// Organization schema
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "TechVerse",
  "url": siteUrl.toString(),
  "logo": new URL('/favicon.svg', siteUrl).toString(),
  "sameAs": []
};

// BlogPosting schema (only for articles)
const articleSchema = article ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title.replace(' - TechVerse', ''),
  "description": description,
  "image": ogImageURL.toString(),
  "datePublished": pubDate?.toISOString(),
  ...(updatedDate ? { "dateModified": updatedDate.toISOString() } : (pubDate ? { "dateModified": pubDate.toISOString() } : {})),
  "author": {
    "@type": "Person",
    "name": author,
    "url": new URL('/about', siteUrl).toString()
  },
  "publisher": {
    "@type": "Organization",
    "name": "TechVerse",
    "logo": {
      "@type": "ImageObject",
      "url": new URL('/favicon.svg', siteUrl).toString()
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.toString()
  },
  ...(category ? { "articleSection": category } : {}),
  ...(tags.length > 0 ? { "keywords": tags.join(', ') } : {}),
  "inLanguage": "hi"
} : null;
---

<!DOCTYPE html>
<html lang="hi" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="0jbeEAMkegAUbGnfE15LnqdZouejOzlPq_4jq168XDE" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <link rel="canonical" href={canonicalURL} />
    
    <!-- hreflang for Hinglish content -->
    <link rel="alternate" hreflang="hi" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    
    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="TechVerse" />
    <meta property="og:locale" content="hi_IN" />
    
    {/* Article-specific OG tags */}
    {article && pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}
    {article && updatedDate && (
      <meta property="article:modified_time" content={updatedDate.toISOString()} />
    )}
    {article && author && (
      <meta property="article:author" content={author} />
    )}
    {article && category && (
      <meta property="article:section" content={category} />
    )}
    {article && tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <!-- Google Fonts with preconnect and font-display swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3255404615799871" crossorigin="anonymous"></script>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BJ9GZFXS6M"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-BJ9GZFXS6M');
    </script>

    <!-- Structured Data: WebSite + Organization -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    
    <!-- Structured Data: BlogPosting (articles only) -->
    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 font-sans antialiased transition-colors duration-200">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
