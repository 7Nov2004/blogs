---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  category?: string;
  tags?: string[];
  faqs?: { question: string; answer: string }[];
  breadcrumbs?: { name: string; href?: string }[];
  noindex?: boolean;
}

const { 
  title, 
  description, 
  image = '/og-default.png', 
  article = false,
  pubDate,
  updatedDate,
  author = 'TechVerse Team',
  category,
  tags = [],
  faqs = [],
  breadcrumbs = [],
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site || 'https://techverseblogs.in';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(image, siteUrl);

// WebSite schema (always present)
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "TechVerse",
  "url": siteUrl.toString(),
  "description": "Tech ki Duniya, Hinglish Mein! Latest AI updates, coding tutorials, gadget reviews aur tech tips.",
  "inLanguage": "hi-Latn",
  "potentialAction": {
    "@type": "SearchAction",
    "target": new URL('/blog/?q={search_term_string}', siteUrl).toString(),
    "query-input": "required name=search_term_string"
  }
};

// Organization schema
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "TechVerse",
  "url": siteUrl.toString(),
  "logo": new URL('/favicon.svg', siteUrl).toString(),
  "sameAs": [
    "https://twitter.com/TechVerse_HI",
    "https://www.instagram.com/techverseblogs",
    "https://www.youtube.com/@TechVerseHindi"
  ]
};

// BlogPosting schema (only for articles)
const articleSchema = article ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title.replace(' - TechVerse', ''),
  "description": description,
  "image": ogImageURL.toString(),
  "datePublished": pubDate?.toISOString(),
  ...(updatedDate ? { "dateModified": updatedDate.toISOString() } : (pubDate ? { "dateModified": pubDate.toISOString() } : {})),
  "author": {
    "@type": "Person",
    "name": author,
    "url": new URL('/about', siteUrl).toString()
  },
  "publisher": {
    "@type": "Organization",
    "name": "TechVerse",
    "logo": {
      "@type": "ImageObject",
      "url": new URL('/favicon.svg', siteUrl).toString()
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.toString()
  },
  ...(category ? { "articleSection": category } : {}),
  ...(tags.length > 0 ? { "keywords": tags.join(', ') } : {}),
  "inLanguage": "hi-Latn"
} : null;

// FAQ Schema
const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;

// BreadcrumbList Schema
const breadcrumbSchema = breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl.toString()
    },
    ...breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      "position": index + 2,
      "name": crumb.name,
      ...(crumb.href ? { "item": new URL(crumb.href, siteUrl).toString() } : {})
    }))
  ]
} : null;
---

<!DOCTYPE html>
<html lang="hi-Latn" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="0jbeEAMkegAUbGnfE15LnqdZouejOzlPq_4jq168XDE" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="theme-color" content="#0b0f19" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    
    <link rel="canonical" href={canonicalURL} />
    
    <!-- hreflang for Hinglish content -->
    <link rel="alternate" hreflang="hi-Latn" href={canonicalURL} />
    <link rel="alternate" hreflang="en-IN" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    
    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="TechVerse" />
    <meta property="og:locale" content="hi_IN" />
    
    {/* Article-specific OG tags */}
    {article && pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}
    {article && updatedDate && (
      <meta property="article:modified_time" content={updatedDate.toISOString()} />
    )}
    {article && author && (
      <meta property="article:author" content={author} />
    )}
    {article && category && (
      <meta property="article:section" content={category} />
    )}
    {article && tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <!-- Google Fonts with preconnect and font-display swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3255404615799871" crossorigin="anonymous"></script>

    <!-- Google Analytics (GA4) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5GDTNYHWLV"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'G-5GDTNYHWLV');
    </script>

    <!-- Structured Data: WebSite + Organization -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    
    <!-- Structured Data: BlogPosting (articles only) -->
    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}

    <!-- Structured Data: FAQPage (articles with FAQs) -->
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}

    <!-- Structured Data: BreadcrumbList -->
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 font-sans antialiased transition-colors duration-200">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
