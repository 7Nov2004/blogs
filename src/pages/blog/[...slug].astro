---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdBanner from '../../components/AdBanner.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const readingTime = Math.ceil(post.body.split(/\s+/).length / 200);

// Category display names
const categoryNames: Record<string, string> = {
  ai: 'AI & Machine Learning',
  webdev: 'Web Development',
  gadgets: 'Gadgets & Reviews',
  tips: 'Tips & Tricks',
};
const categoryName = categoryNames[post.data.category] || post.data.category;

// Related posts (same category, then by shared tags)
const allPosts = await getCollection('blog');
const sortedPosts = [...allPosts].sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
const currentIndex = sortedPosts.findIndex((p) => p.slug === post.slug);
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;

const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .map((p) => {
    let score = 0;
    if (p.data.category === post.data.category) score += 3;
    const sharedTags = (p.data.tags || []).filter((t: string) => (post.data.tags || []).includes(t));
    score += sharedTags.length;
    return { post: p, score };
  })
  .filter((p) => p.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 4)
  .map((p) => p.post);

// Breadcrumb items
const breadcrumbItems = [
  { name: categoryName, href: `/category/${post.data.category}` },
  { name: post.data.title },
];
---

<BaseLayout 
  title={`${post.data.title} - TechVerse`} 
  description={post.data.description}
  image={post.data.image || post.data.coverImage}
  article={true}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  category={categoryName}
  tags={post.data.tags}
  faqs={post.data.faqs || []}
  breadcrumbs={[
    { name: categoryName, href: `/category/${post.data.category}` },
    { name: post.data.title }
  ]}
>
  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="fixed top-0 left-0 h-1.5 bg-gradient-to-r from-blue-500 via-indigo-500 to-purple-600 z-[100] transition-all duration-75 w-0 shadow-[0_0_12px_rgba(59,130,246,0.8)]"></div>

  <!-- Toast Notification -->
  <div id="toast" class="fixed bottom-6 right-6 bg-gray-900 text-white px-5 py-3 rounded-xl shadow-2xl z-50 text-sm font-medium flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none border border-gray-700">
    <span class="text-green-400">✓</span> Link copied to clipboard!
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      
      <!-- Main content area -->
      <article class="lg:col-span-2">
        <!-- Breadcrumb -->
        <Breadcrumb items={breadcrumbItems} />

        <header class="mb-10">
          <div class="flex items-center gap-3 mb-6 flex-wrap">
            <a href={`/category/${post.data.category}`} class="inline-block px-4 py-1.5 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 text-sm font-bold rounded-full hover:bg-blue-100 dark:hover:bg-blue-900/50 transition-colors">
              {categoryName}
            </a>
            {post.data.sponsored && (
              <span class="inline-block px-4 py-1.5 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-300 text-sm font-bold rounded-full">
                Sponsored
              </span>
            )}
          </div>
          
          <h1 class="text-3xl md:text-5xl font-extrabold mb-6 dark:text-white leading-tight">
            {post.data.title}
          </h1>
          
          <div class="flex items-center gap-4 text-gray-600 dark:text-gray-400 pb-8 border-b border-gray-200 dark:border-gray-700">
            <div class="w-10 h-10 rounded-full overflow-hidden flex items-center justify-center flex-shrink-0 border border-blue-200 dark:border-gray-700">
              <img src="/images/author-avatar.jpg" alt={post.data.author || 'TechVerse Admin'} class="w-full h-full object-cover" width="40" height="40" />
            </div>
            <div>
              <p class="font-medium text-gray-900 dark:text-gray-200">{post.data.author || 'TechVerse Admin'}</p>
              <div class="flex items-center gap-2 text-sm">
                <time datetime={post.data.pubDate.toISOString()}>
                  {new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                </time>
                {post.data.updatedDate && (
                  <>
                    <span>•</span>
                    <span>Updated: {new Date(post.data.updatedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                  </>
                )}
                <span>•</span>
                <span>{readingTime} min read</span>
              </div>
            </div>
          </div>
        </header>

        {(post.data.image || post.data.coverImage) && (
          <div class="mb-10 rounded-2xl overflow-hidden shadow-lg border border-gray-100 dark:border-gray-800 bg-gray-100 dark:bg-gray-800 aspect-video">
            <Image src={(post.data.image || post.data.coverImage)!} alt={post.data.title} class="w-full h-full object-cover" width={800} height={450} inferSize={true} />
          </div>
        )}

        <!-- Table of Contents -->
        <TableOfContents headings={headings} />

        <div class="mb-8">
          <AdBanner slot='in-article' />
        </div>

        <div class="prose-blog prose prose-lg dark:prose-invert max-w-none mb-12 prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-blue-400 hover:prose-a:text-blue-500 prose-img:rounded-xl">
          <Content />
        </div>

        <!-- Share Buttons & Community Callout -->
        <div class="p-6 bg-gray-50 dark:bg-gray-800/60 rounded-2xl border border-gray-200 dark:border-gray-700 mb-10">
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pb-6 border-b border-gray-200 dark:border-gray-700">
            <div>
              <h3 class="font-bold text-gray-900 dark:text-white text-base">Ye article kaisa laga? Share karein:</h3>
              <p class="text-xs text-gray-500 dark:text-gray-400">Apne doston ki madad karein useful tech jankari share karke!</p>
            </div>
            <div class="flex items-center gap-2.5">
              <button onclick="shareWhatsApp()" class="px-4 py-2 rounded-xl bg-[#25D366] hover:bg-[#20bd5a] text-white flex items-center gap-2 font-medium text-sm shadow-sm transition-all transform hover:scale-105" aria-label="Share on WhatsApp">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.062-1.745-.371-.871-.358-1.579-1.042-2.127-1.787-.042-.057-.59-.81-.59-1.545 0-.735.385-1.096.522-1.242.137-.146.3-.183.4-.183.1 0 .2.001.288.005.093.004.218-.035.34.258.125.299.426 1.041.464 1.117.038.076.063.164.013.264-.05.099-.075.161-.15.249-.075.088-.158.196-.226.264-.075.075-.153.157-.066.306.088.15.388.641.832 1.036.571.508 1.052.665 1.202.739.15.074.238.064.326-.037.088-.101.376-.438.476-.588.1-.15.2-.125.338-.075.138.05.877.413 1.028.488.15.075.25.112.288.175.038.063.038.368-.106.773z"/></svg>
                WhatsApp
              </button>
              <button onclick="shareTwitter()" class="p-2.5 rounded-xl bg-black hover:bg-gray-800 text-white flex items-center justify-center transition-all transform hover:scale-105" aria-label="Share on X" title="Share on X">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </button>
              <button onclick="copyLink()" class="p-2.5 rounded-xl bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 flex items-center justify-center transition-all transform hover:scale-105" title="Copy Link" aria-label="Copy link">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
              </button>
            </div>
          </div>
          <!-- Community CTA -->
          <div class="pt-5 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3 text-left">
              <span class="text-3xl">🚀</span>
              <div>
                <p class="font-bold text-gray-900 dark:text-white text-sm">TechVerse VIP Community</p>
                <p class="text-xs text-gray-500 dark:text-gray-400">Har roz nayi tech tips, hidden AI tools aur discount deals ke liye judein!</p>
              </div>
            </div>
            <a href="https://techverseblogs.in" target="_blank" rel="noopener noreferrer" class="whitespace-nowrap px-4 py-2 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white text-xs font-bold rounded-xl shadow-md transition-all">
              Bookmark TechVerse ★
            </a>
          </div>
        </div>

        <div class="mb-12">
          <AdBanner slot='in-article' />
        </div>

        {/* Clickable Tags */}
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-12">
            <span class="font-bold text-gray-900 dark:text-white mr-2">Tags:</span>
            {post.data.tags.map((tag: string) => (
              <a href={`/tag/${tag}`} class="px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 text-sm rounded-md border border-gray-200 dark:border-gray-700 hover:bg-primary-50 dark:hover:bg-primary-900/20 hover:text-primary-600 dark:hover:text-primary-400 hover:border-primary-300 dark:hover:border-primary-700 transition-colors">
                #{tag}
              </a>
            ))}
          </div>
        )}

        <!-- Author Bio Card -->
        <div class="bg-gray-50 dark:bg-gray-800/50 rounded-2xl p-6 mb-16 border border-gray-200 dark:border-gray-700 flex flex-col sm:flex-row items-center sm:items-start gap-6">
           <div class="w-20 h-20 rounded-full overflow-hidden flex-shrink-0 border-2 border-blue-500 shadow-md">
             <img src="/images/author-avatar.jpg" alt={post.data.author || 'TechVerse Admin'} class="w-full h-full object-cover" width="80" height="80" />
           </div>
        <div class="text-center sm:text-left">
             <h4 class="text-xl font-bold dark:text-white mb-2">{post.data.author || 'TechVerse Team'}</h4>
             <p class="text-gray-600 dark:text-gray-400 text-sm mb-4">
               {(post.data.author === 'Aayush') 
                 ? 'Aayush TechVerse ke Founder aur Lead Editor hain. 5+ saalon se technology, AI tools, aur gadgets par Hindi mein research aur writing karte hain. Unka maqsad hai complex tech ko simple Hinglish mein samjhana.'
                 : 'TechVerse team tech enthusiasts, developers aur writers ka ek samooha hai jo technology ko aasan Hinglish mein samjhane ke liye dedicated hai.'
               }
             </p>
             <a href="/about" class="inline-flex items-center gap-1 text-blue-600 dark:text-blue-400 text-xs font-semibold hover:underline">Lekhak ke baare mein aur jaanein →</a>
           </div>
        </div>

        <!-- Related Posts (improved: by tags + category, shows up to 4) -->
        {relatedPosts.length > 0 && (
          <div class="mb-16">
            <h3 class="text-2xl font-bold mb-6 dark:text-white">Related Posts 🔍</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {relatedPosts.map((rp) => (
                <a href={`/blog/${rp.slug}`} class="group bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-md transition-all duration-300 border border-gray-100 dark:border-gray-700 overflow-hidden flex flex-col">
                  {rp.data.image && (
                    <div class="h-32 w-full overflow-hidden bg-gray-100 dark:bg-gray-700">
                      <img src={rp.data.image} alt={rp.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" width="400" height="200" />
                    </div>
                  )}
                  <div class="p-5 flex flex-col h-full">
                    <h4 class="text-lg font-bold mb-2 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
                      {rp.data.title}
                    </h4>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-auto pt-4">
                      {new Date(rp.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Next / Previous Article Navigation -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-16">
          {prevPost ? (
            <a href={`/blog/${prevPost.slug}`} class="group p-5 bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 hover:border-blue-500 dark:hover:border-blue-500 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
              <div>
                <span class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider mb-2 inline-flex items-center gap-1">
                  ← Pichla Article
                </span>
                <h4 class="font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2 text-base mt-1">
                  {prevPost.data.title}
                </h4>
              </div>
              <span class="text-xs text-gray-400 mt-4">
                {new Date(prevPost.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
              </span>
            </a>
          ) : <div class="hidden sm:block"></div>}
          
          {nextPost ? (
            <a href={`/blog/${nextPost.slug}`} class="group p-5 bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 hover:border-purple-500 dark:hover:border-purple-500 shadow-sm hover:shadow-md transition-all flex flex-col justify-between text-right items-end">
              <div>
                <span class="text-xs font-bold text-purple-600 dark:text-purple-400 uppercase tracking-wider mb-2 inline-flex items-center justify-end gap-1">
                  Agla Article →
                </span>
                <h4 class="font-bold text-gray-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors line-clamp-2 text-base mt-1">
                  {nextPost.data.title}
                </h4>
              </div>
              <span class="text-xs text-gray-400 mt-4">
                {new Date(nextPost.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
              </span>
            </a>
          ) : <div></div>}
        </div>

        <NewsletterSignup variant='inline' />
      </article>

      <!-- Sidebar -->
      <aside class="hidden lg:block lg:col-span-1 space-y-10">
        <div class="sticky top-20 space-y-10">
          <AdBanner slot='sidebar' />
          
          <!-- Popular Posts (First 5 all posts for now) -->
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 p-6">
            <h3 class="text-lg font-bold mb-4 dark:text-white pb-2 border-b border-gray-100 dark:border-gray-700">Popular Posts 🔥</h3>
            <ul class="space-y-4">
              {allPosts
                .filter(p => p.slug !== post.slug && (p.data.featured || ['best-power-banks-india-2026','chatgpt-se-paise-kaise-kamaye','google-gemini-vs-chatgpt-hindi','whatsapp-new-features-2026-hindi','upi-tap-pay-nfc-payment-kya-hai-2026'].includes(p.slug)))
                .slice(0, 5)
                .map(p => (
                <li>
                  <a href={`/blog/${p.slug}`} class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 font-medium text-sm line-clamp-2 transition-colors">
                    {p.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Categories -->
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 p-6">
            <h3 class="text-lg font-bold mb-4 dark:text-white pb-2 border-b border-gray-100 dark:border-gray-700">Categories 📂</h3>
            <ul class="space-y-2">
              <li><a href="/category/ai" class="flex items-center justify-between text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors"><span>🤖 AI & ML</span></a></li>
              <li><a href="/category/webdev" class="flex items-center justify-between text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors"><span>💻 Web Dev</span></a></li>
              <li><a href="/category/gadgets" class="flex items-center justify-between text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors"><span>📱 Gadgets</span></a></li>
              <li><a href="/category/tips" class="flex items-center justify-between text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors"><span>💡 Tips</span></a></li>
            </ul>
          </div>

          <AdBanner slot='sidebar' />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  const pageURL = window.location.href;
  const pageTitle = document.title.replace(' - TechVerse', '');

  window.shareWhatsApp = () => {
    const text = encodeURIComponent(`🔥 ${pageTitle} - Ye article zaroor padhein:\n\n${pageURL}`);
    window.open(`https://wa.me/?text=${text}`, '_blank');
  };
  
  window.shareTwitter = () => {
    const text = encodeURIComponent(`Check out: ${pageTitle} via @TechVerse`);
    window.open(`https://twitter.com/intent/tweet?url=${encodeURIComponent(pageURL)}&text=${text}`, '_blank');
  };
  
  window.shareLinkedIn = () => {
    window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageURL)}`, '_blank');
  };
  
  window.copyLink = () => {
    navigator.clipboard.writeText(pageURL).then(() => {
      const toast = document.getElementById('toast');
      if (toast) {
        toast.classList.remove('translate-y-20', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');
        setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100');
          toast.classList.add('translate-y-20', 'opacity-0');
        }, 2500);
      }
    });
  };

  // Scroll Progress Bar
  const progressBar = document.getElementById('reading-progress');
  if (progressBar) {
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
      progressBar.style.width = scrolled + '%';
    });
  }

  // Code Block Copy Buttons
  document.querySelectorAll('.prose-blog pre').forEach((pre) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'relative group';
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const btn = document.createElement('button');
    btn.className = 'absolute top-3 right-3 px-2.5 py-1 text-xs font-semibold text-gray-300 bg-gray-800/80 hover:bg-gray-700 backdrop-blur rounded-md border border-gray-600 transition-all opacity-0 group-hover:opacity-100 focus:opacity-100';
    btn.textContent = 'Copy';
    btn.setAttribute('aria-label', 'Copy code');

    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.innerText || pre.innerText;
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = '✓ Copied!';
        btn.classList.add('text-green-400', 'border-green-500');
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('text-green-400', 'border-green-500');
        }, 2000);
      } catch (err) {
        btn.textContent = 'Failed';
      }
    });

    wrapper.appendChild(btn);
  });
</script>
