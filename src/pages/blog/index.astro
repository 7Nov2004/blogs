---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const categories = [
  { name: 'All', slug: '/blog' },
  { name: 'AI & ML', slug: '/category/ai' },
  { name: 'Web Dev', slug: '/category/webdev' },
  { name: 'Gadgets', slug: '/category/gadgets' },
  { name: 'Tips', slug: '/category/tips' },
];
---

<BaseLayout title="Blog - TechVerse" description="TechVerse ke sabhi posts padhein.">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-6 dark:text-white">Sab Posts 📚</h1>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
        Explore our latest articles, tutorials, and tech updates.
      </p>
    </div>

    <!-- Category Filters -->
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      {categories.map((cat) => (
        <a href={cat.slug} 
           class={`px-5 py-2.5 rounded-full font-medium transition-all ${cat.name === 'All' ? 'bg-blue-600 text-white shadow-md' : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 border border-gray-200 dark:border-gray-700'}`}>
          {cat.name}
        </a>
      ))}
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {allPosts.map((post) => (
        <a href={`/blog/${post.slug}`} class="group bg-white dark:bg-gray-800 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 overflow-hidden border border-gray-100 dark:border-gray-700 flex flex-col h-full">
          <div class="h-48 w-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center relative">
             <span class="text-gray-400 dark:text-gray-500">Image Placeholder</span>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="inline-block px-3 py-1 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 text-xs font-semibold rounded-full mb-4 w-fit">
              {post.data.category}
            </span>
            <h2 class="text-2xl font-bold mb-3 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {post.data.title}
            </h2>
            <p class="text-gray-600 dark:text-gray-400 line-clamp-2 mb-6 flex-grow">
              {post.data.description}
            </p>
            <div class="flex items-center justify-between text-sm text-gray-500 dark:text-gray-400 pt-4 border-t border-gray-100 dark:border-gray-700">
              <span>{new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
              <span>{Math.ceil(post.body.length / 1000)} min read</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
