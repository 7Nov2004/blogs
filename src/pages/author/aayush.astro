---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const allPosts = await getCollection('blog');
const authorPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const authorDetails = {
  name: 'Aayush Sharma',
  role: 'Founder, Lead Technical Editor & Gadget Researcher',
  location: 'Noida / Delhi NCR, Uttar Pradesh, India',
  email: 'contact@techverseblogs.in',
  github: 'https://github.com/7Nov2004',
  bio: `Main ek software developer aur consumer electronics enthusiast hoon. 5+ saalon se modern web frameworks (React, Next.js, Astro), generative AI tools, Linux system architecture, aur smartphone hardware par research kar raha hoon. Mera mission hai ki technology ki complex information ko 100% authentic, transparent aur simplified Hinglish bhasha mein har Indian reader tak pahunchaya jaye.`,
  experience: [
    '5+ years hands-on experience in Full-Stack Web Development and DevOps.',
    'Tested over 60+ Android & iOS smartphones, TWS audio gear, and Smart TVs.',
    'Active contributor to open-source software and developer communities on GitHub.',
    'Lead Editor establishing strict E-E-A-T factual verification guidelines on TechVerse.'
  ]
};
---

<BaseLayout 
  title={`${authorDetails.name} — Author & Lead Editor at TechVerse`} 
  description={`TechVerse ke Founder aur Lead Editor ${authorDetails.name} ke verified articles, tech research aur professional background ke baare mein jaanein.`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Author Profile Header -->
    <div class="bg-gradient-to-br from-slate-900 via-blue-950 to-indigo-950 rounded-3xl p-8 md:p-12 text-white shadow-xl border border-blue-900/40 mb-12 flex flex-col md:flex-row items-center gap-8">
      <div class="w-36 h-36 md:w-44 md:h-44 rounded-full bg-gradient-to-tr from-blue-400 to-purple-500 p-1.5 flex-shrink-0 shadow-2xl">
        <div class="w-full h-full bg-slate-800 rounded-full overflow-hidden">
          <img src="/images/author-avatar.jpg" alt={authorDetails.name} class="w-full h-full object-cover" />
        </div>
      </div>
      
      <div class="text-center md:text-left flex-grow">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-500/20 border border-blue-400/30 text-xs font-semibold text-blue-200 mb-3">
          <span>Verified Author & Reviewer</span>
          <span>✓</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-black mb-2 tracking-tight">{authorDetails.name}</h1>
        <p class="text-blue-300 font-semibold text-lg mb-4">{authorDetails.role}</p>
        <p class="text-slate-300 text-sm md:text-base leading-relaxed max-w-3xl mb-6">
          {authorDetails.bio}
        </p>

        <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 text-xs text-slate-300">
          <span class="flex items-center gap-1.5 bg-white/10 px-3 py-1.5 rounded-lg">
            📍 {authorDetails.location}
          </span>
          <a href={`mailto:${authorDetails.email}`} class="flex items-center gap-1.5 bg-white/10 hover:bg-white/20 px-3 py-1.5 rounded-lg transition-colors">
            ✉️ {authorDetails.email}
          </a>
          <a href={authorDetails.github} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 bg-white/10 hover:bg-white/20 px-3 py-1.5 rounded-lg transition-colors">
            💻 GitHub Profile
          </a>
        </div>
      </div>
    </div>

    <!-- Expertise & Testing Standards Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      <div class="bg-white dark:bg-gray-800 rounded-2xl p-8 border border-gray-100 dark:border-gray-700 shadow-sm">
        <h2 class="text-2xl font-bold mb-4 dark:text-white flex items-center gap-2">
          <span>🎯</span> Expertise & Experience
        </h2>
        <ul class="space-y-3 text-gray-600 dark:text-gray-300 text-sm">
          {authorDetails.experience.map((exp) => (
            <li class="flex items-start gap-2">
              <span class="text-blue-500 font-bold">✓</span>
              <span>{exp}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="bg-white dark:bg-gray-800 rounded-2xl p-8 border border-gray-100 dark:border-gray-700 shadow-sm">
        <h2 class="text-2xl font-bold mb-4 dark:text-white flex items-center gap-2">
          <span>🔍</span> Editorial Transparency & Ethics
        </h2>
        <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-4">
          TechVerse par publish hone wali har buyer guide aur review mere personal testing aur authentic benchmark metrics par based hoti hai. Hum kisi bhi brand se paid positive reviews accept nahi karte.
        </p>
        <a href="/about" class="text-blue-600 dark:text-blue-400 font-bold text-sm hover:underline inline-flex items-center gap-1">
          TechVerse Editorial Policy Padhien →
        </a>
      </div>
    </div>

    <!-- Author's Published Articles -->
    <div>
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-gray-200 dark:border-gray-700">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold dark:text-white">Articles By {authorDetails.name}</h2>
          <p class="text-gray-500 dark:text-gray-400 text-sm">Verified technical tutorials, buying guides aur reviews</p>
        </div>
        <span class="text-xs font-bold px-3 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900">
          {authorPosts.length} Articles
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {authorPosts.map((post) => (
          <a href={`/blog/${post.slug}/` } class="group bg-white dark:bg-gray-800 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 overflow-hidden border border-gray-100 dark:border-gray-700 flex flex-col h-full">
            <div class="h-44 w-full bg-gray-100 dark:bg-gray-700 overflow-hidden relative">
              {(post.data.image || post.data.coverImage) ? (
                <Image src={(post.data.image || post.data.coverImage)!} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={600} height={350} />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-400">TechVerse</div>
              )}
            </div>
            <div class="p-6 flex flex-col flex-grow">
              <span class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider mb-2">
                {post.data.category}
              </span>
              <h3 class="text-lg font-bold mb-3 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2 leading-snug">
                {post.data.title}
              </h3>
              <p class="text-gray-600 dark:text-gray-400 line-clamp-2 mb-6 flex-grow text-sm">
                {post.data.description}
              </p>
              <div class="text-xs text-gray-400 pt-4 border-t border-gray-100 dark:border-gray-700 flex justify-between">
                <span>{new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                <span class="font-medium text-blue-600 dark:text-blue-400 group-hover:underline">Read Guide →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
