---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const slugify = (s: string) => s.toLowerCase().trim().replace(/\s+/g, '-');

export async function getStaticPaths() {
  const slugify = (s: string) => s.toLowerCase().trim().replace(/\s+/g, '-');
  const allPosts = await getCollection('blog');
  
  const tagMap = new Map<string, { slug: string; name: string }>();
  allPosts.forEach((post) => {
    (post.data.tags || []).forEach((tag: string) => {
      const slug = slugify(tag);
      if (!tagMap.has(slug)) {
        tagMap.set(slug, { slug, name: tag });
      }
    });
  });
  
  return Array.from(tagMap.values()).map(({ slug, name }) => ({
    params: { tag: slug },
    props: { tag: slug, tagName: name },
  }));
}

const { tag, tagName } = Astro.props;

const allPosts = (await getCollection('blog'))
  .filter((post) => (post.data.tags || []).some((t: string) => slugify(t) === tag))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Format tag name for display
const displayTag = tagName || tag
  .replace(/-/g, ' ')
  .replace(/\b\w/g, (c: string) => c.toUpperCase());

// Curated topic descriptions for rich SEO & AdSense compliance
const tagDescriptions: Record<string, string> = {
  'tech-tips': 'Daily digital life, smartphones aur Windows OS ko supercharge karne ke tested aur practical solutions. Yahan aapko performance tweaks, storage recovery aur hidden settings ki detailed guides milengi.',
  'ai': 'Artificial Intelligence, ChatGPT, Google Gemini, Claude aur local LLMs ke latest models ka in-depth analysis. Janein kaise AI tools se coding aur research 10x fast ho sakti hai.',
  'webdev': 'Frontend se lekar backend aur cloud architecture tak ka complete web development hub. React, Next.js, TypeScript aur clean code best practices Hindi mein.',
  'reviews': 'Unbiased, lab-tested hardware aur gadget reviews. Real battery drain tests, display color analysis aur camera performance metrics bina kisi brand sponsorship ke.',
  'gadgets': 'Smartphones, 4K TVs, smartwatches aur smart home tech ka ultimate buyer destination. Janein kaun sa tech gadget aapke budget aur needs ke liye perfect hai.',
  'cyber-safety': 'Online scams, Telegram job frauds, SIM swap attacks aur data privacy threats se bachne ke certified cybersecurity rules aur recovery portals ki complete guide.',
  'smartphones': 'Best 5G smartphones, flagship processors, AMOLED display repairs aur battery optimization ke authentic benchmark guides.',
  'shopping-deals': 'Amazon Great Indian Festival aur Flipkart Big Billion Days mein price history tracking, authentic discounts aur smart buying frameworks.',
  'government-services': 'Sanchar Saathi, TAFCOP SIM check, CEIR lost phone portal, myAadhaar security aur IRCTC Tatkal fast booking ke verified government tutorials.',
  'earbuds': 'True Wireless (TWS), Active Noise Cancellation (ANC) aur low-latency gaming earphones ke lab tests, EQ settings aur one-side fix troubleshooting.',
  'fintech': 'UPI Tap Pay, NFC contactless cards, RBI online dispute rules aur lifetime free credit cards ka smart financial guide.',
  'laptops': 'College students aur software developers ke liye lightweight laptops, RAM/SSD upgrades, battery saver tweaks aur thermal cooling guides.',
  'windows-11': 'Windows 11 ko 3x fast banane ke proven techniques, registry tweaks, bloatware uninstaller scripts aur startup acceleration hacks.',
  'telecom': 'Jio True 5G vs Airtel 5G Plus speed tests, APN internet settings, unlimited data fair usage policies aur Indian telecom updates.',
  'freelancing': 'Upwork, Fiverr aur international client work ke liye freelance skills roadmap, portfolio setup aur payment gateway guidance.',
  'students': 'College exams, competitive prep aur self-study ke liye free AI productivity tools, PDF notes summary aur smart academic hacks.',
};

const topicOverview = tagDescriptions[tag] || `TechVerse #${displayTag} topic hub mein is vishay se jude sabhi authentic tutorials, expert tips aur benchmark comparisons padhein.`;

const categories = [
  { name: 'AI & Machine Learning', slug: 'ai', emoji: '🤖', color: 'from-purple-500 to-pink-500' },
  { name: 'Web Development', slug: 'webdev', emoji: '💻', color: 'from-blue-500 to-cyan-500' },
  { name: 'Gadgets & Reviews', slug: 'gadgets', emoji: '📱', color: 'from-green-500 to-emerald-500' },
  { name: 'Tips & Tricks', slug: 'tips', emoji: '💡', color: 'from-amber-500 to-orange-500' },
];
---

<BaseLayout 
  title={`#${displayTag} Guides & Tutorials — TechVerse`} 
  description={`${topicOverview.slice(0, 150)}...`}
  noindex={false}
  breadcrumbs={[
    { name: `#${displayTag}`, href: `/tag/${tag}/` }
  ]}
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <!-- Tag Hero with Rich Editorial Context -->
    <div class="relative overflow-hidden bg-gradient-to-br from-blue-900/20 via-indigo-950/20 to-purple-900/20 dark:from-gray-800/60 dark:to-gray-900/80 rounded-3xl p-8 md:p-12 mb-12 border border-blue-100/80 dark:border-gray-700/80 shadow-sm backdrop-blur-sm">
      <div class="flex flex-col md:flex-row items-center gap-6 text-center md:text-left">
        <div class="w-20 h-20 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-4xl shadow-lg shrink-0">
          🏷️
        </div>
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-xs font-semibold rounded-full mb-2">
            <span>Verified Tech Hub</span>
            <span>•</span>
            <span>{allPosts.length} Comprehensive Articles</span>
          </div>
          <h1 class="text-3xl md:text-4xl font-black mb-3 dark:text-white tracking-tight">#{displayTag}</h1>
          <p class="text-base md:text-lg text-gray-700 dark:text-gray-300 max-w-3xl leading-relaxed">
            {topicOverview}
          </p>
        </div>
      </div>

      <!-- Quick Highlights Bar -->
      <div class="mt-8 pt-6 border-t border-blue-200/40 dark:border-gray-700/60 flex flex-wrap items-center justify-between gap-4 text-xs text-gray-600 dark:text-gray-400">
        <div class="flex items-center gap-4">
          <span class="flex items-center gap-1 font-medium text-emerald-600 dark:text-emerald-400">
            ✓ 100% Original Research
          </span>
          <span class="flex items-center gap-1">
            ✓ Practical Step-by-Step
          </span>
          <span class="flex items-center gap-1">
            ✓ Regularly Updated (2026)
          </span>
        </div>
        <div class="text-slate-500">
          Curated by TechVerse Editorial Team
        </div>
      </div>
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      {allPosts.map((post) => (
        <a href={`/blog/${post.slug}/`} class="group bg-white dark:bg-gray-800 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 overflow-hidden border border-gray-100 dark:border-gray-700 flex flex-col h-full">
          <div class="h-48 w-full bg-gray-100 dark:bg-gray-700 overflow-hidden relative">
            {post.data.image ? (
              <Image src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={600} height={350} />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-gray-400">TechVerse</div>
            )}
            <span class="absolute top-3 left-3 px-3 py-1 bg-black/60 backdrop-blur-md text-white text-xs font-semibold rounded-full border border-white/20">
              {categories.find(c => c.slug === post.data.category)?.name || post.data.category}
            </span>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <h2 class="text-xl font-bold mb-3 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2 leading-snug">
              {post.data.title}
            </h2>
            <p class="text-gray-600 dark:text-gray-400 line-clamp-2 mb-6 flex-grow text-sm leading-relaxed">
              {post.data.description}
            </p>
            <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400 pt-4 border-t border-gray-100 dark:border-gray-700">
              <span class="flex items-center gap-1 font-medium">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                {new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </span>
              <span class="flex items-center gap-1 font-medium text-blue-600 dark:text-blue-400">
                Read Guide →
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Related Topics Discovery -->
    <div class="bg-slate-50 dark:bg-gray-800/40 rounded-2xl p-8 border border-slate-200/80 dark:border-gray-700/60 text-center mb-12">
      <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Explore More Topics</h3>
      <div class="flex flex-wrap items-center justify-center gap-2">
        <a href="/tag/ai/" class="px-3.5 py-1.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-sm text-gray-700 dark:text-gray-300 hover:border-blue-500 transition-colors">#AI</a>
        <a href="/tag/webdev/" class="px-3.5 py-1.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-sm text-gray-700 dark:text-gray-300 hover:border-blue-500 transition-colors">#WebDev</a>
        <a href="/tag/smartphones/" class="px-3.5 py-1.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-sm text-gray-700 dark:text-gray-300 hover:border-blue-500 transition-colors">#Smartphones</a>
        <a href="/tag/tech-tips/" class="px-3.5 py-1.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-sm text-gray-700 dark:text-gray-300 hover:border-blue-500 transition-colors">#TechTips</a>
        <a href="/tag/cyber-safety/" class="px-3.5 py-1.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-sm text-gray-700 dark:text-gray-300 hover:border-blue-500 transition-colors">#CyberSafety</a>
        <a href="/tag/earbuds/" class="px-3.5 py-1.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-sm text-gray-700 dark:text-gray-300 hover:border-blue-500 transition-colors">#Earbuds</a>
        <a href="/tag/government-services/" class="px-3.5 py-1.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-sm text-gray-700 dark:text-gray-300 hover:border-blue-500 transition-colors">#GovtServices</a>
        <a href="/tag/shopping-deals/" class="px-3.5 py-1.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-sm text-gray-700 dark:text-gray-300 hover:border-blue-500 transition-colors">#ShoppingDeals</a>
      </div>
    </div>

    <div class="text-center">
      <a href="/blog/" class="inline-flex items-center justify-center px-6 py-3 border border-gray-300 dark:border-gray-600 rounded-full text-base font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
        ← Back to All Posts
      </a>
    </div>
  </div>
</BaseLayout>
