---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdBanner from '../components/AdBanner.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
const featuredPosts = allPosts.slice(0, 3);
const latestPosts = allPosts.slice(0, 8);
const categories = [
  { name: 'AI & Machine Learning', slug: 'ai', emoji: '🤖', color: 'from-purple-500 to-pink-500' },
  { name: 'Web Development', slug: 'webdev', emoji: '💻', color: 'from-blue-500 to-cyan-500' },
  { name: 'Gadgets & Reviews', slug: 'gadgets', emoji: '📱', color: 'from-green-500 to-emerald-500' },
  { name: 'Tips & Tricks', slug: 'tips', emoji: '💡', color: 'from-amber-500 to-orange-500' },
];
---

<BaseLayout 
  title="TechVerse — Latest Tech News, AI Tools & Gadget Reviews in Hindi (2026)" 
  description="TechVerse par payein latest AI updates (ChatGPT, DeepSeek), smartphone reviews, coding roadmaps aur tech hacks simple Hinglish mein. Read honest tech guides today!"
>
  <!-- Hero Section -->
  <section class="relative w-full overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-blue-950 to-indigo-950 text-white py-20 px-6 text-center shadow-2xl mb-16 border border-blue-900/40">
    <!-- Ambient light glow effects -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 right-10 w-80 h-80 bg-purple-500/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-4xl mx-auto">
      <!-- Live Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-xs font-semibold text-blue-200 mb-8 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
        <span>TechVerse 2.0 • Updated for 2026</span>
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black mb-6 leading-tight tracking-tight">
        Tech Ki Duniya, <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 via-cyan-300 to-purple-400">Hinglish Mein!</span>
      </h1>
      
      <p class="text-lg md:text-xl mb-10 text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Latest AI updates, coding tutorials, gadget reviews aur practical tech hacks — bina kisi technical jhanjhat ke, 100% aasan Hinglish mein!
      </p>

      <!-- Search Box on Hero -->
      <form action="/blog/" method="GET" class="max-w-2xl mx-auto mb-6 relative group">
        <div class="absolute inset-0 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full blur opacity-30 group-hover:opacity-60 transition duration-300"></div>
        <div class="relative flex items-center bg-white dark:bg-slate-900/90 backdrop-blur-xl rounded-full border border-white/20 shadow-2xl p-1.5">
          <svg class="w-5 h-5 text-gray-400 ml-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input 
            type="text" 
            name="q" 
            placeholder="Kuch bhi khojein... (e.g. DeepSeek, Jio AirFiber, Windows 11, Laptops)" 
            class="w-full px-4 py-3 bg-transparent text-gray-900 dark:text-white placeholder-gray-400 text-sm md:text-base focus:outline-none"
          />
          <button type="submit" class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold px-6 py-3 rounded-full text-sm transition-all shadow-md flex-shrink-0">
            Khojo
          </button>
        </div>
      </form>

      <!-- Trending Quick Search Tags -->
      <div class="flex flex-wrap items-center justify-center gap-2 text-xs text-slate-400 mb-8">
        <span class="font-semibold text-slate-300">🔥 Trending:</span>
        <a href="/blog/whatsapp-new-features-2026-hindi/" class="px-2.5 py-1 rounded-full bg-white/5 hover:bg-white/15 border border-white/10 text-slate-300 transition-colors">#WhatsApp2026</a>
        <a href="/blog/upi-tap-pay-nfc-payment-kya-hai-2026/" class="px-2.5 py-1 rounded-full bg-white/5 hover:bg-white/15 border border-white/10 text-slate-300 transition-colors">#UPITapPay</a>
        <a href="/blog/iphone-18-pro-features-price-india-2026/" class="px-2.5 py-1 rounded-full bg-white/5 hover:bg-white/15 border border-white/10 text-slate-300 transition-colors">#iPhone18Pro</a>
        <a href="/blog/redmi-note-17-pro-india-launch-specs-price/" class="px-2.5 py-1 rounded-full bg-white/5 hover:bg-white/15 border border-white/10 text-slate-300 transition-colors">#RedmiNote17</a>
      </div>

      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/blog/" class="px-8 py-3.5 bg-white text-slate-900 font-bold rounded-2xl hover:bg-slate-100 transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5 text-base">
          Sabhi Articles Padhein →
        </a>
        <a href="#newsletter" class="px-8 py-3.5 bg-white/10 text-white font-bold rounded-2xl hover:bg-white/20 transition-all border border-white/20 text-base backdrop-blur-md">
          VIP Updates Paayein
        </a>
      </div>
    </div>
  </section>

  <!-- Ad Banner Header -->
  <div class="mb-12">
    <AdBanner slot='header' />
  </div>

  <!-- Featured Posts -->
  <section class="mb-16">
    <h2 class="text-3xl font-bold mb-8 dark:text-white flex items-center gap-2">Featured Posts 🔥</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {featuredPosts.map((post) => (
        <a href={`/blog/${post.slug}/`} class="group bg-white dark:bg-gray-800 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 overflow-hidden border border-gray-100 dark:border-gray-700 flex flex-col h-full">
          <div class="h-48 w-full overflow-hidden bg-gray-100 dark:bg-gray-800 relative">
            {(post.data.image || post.data.coverImage) ? (
              <Image src={(post.data.image || post.data.coverImage)!} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={800} height={450} />
            ) : (
              <div class={`h-full w-full bg-gradient-to-r ${categories.find(c => c.slug === post.data.category)?.color || 'from-blue-500 to-purple-500'}`}></div>
            )}
            <span class="absolute top-3 left-3 px-3 py-1 bg-black/60 backdrop-blur-md text-white text-xs font-semibold rounded-full border border-white/20 shadow-md flex items-center gap-1.5">
              <span>{categories.find(c => c.slug === post.data.category)?.emoji || '⚡'}</span>
              <span>{categories.find(c => c.slug === post.data.category)?.name || post.data.category}</span>
            </span>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <h3 class="text-xl font-bold mb-3 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2 leading-snug">
              {post.data.title}
            </h3>
            <p class="text-gray-600 dark:text-gray-400 line-clamp-2 mb-6 flex-grow text-sm">
              {post.data.description}
            </p>
            <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400 pt-4 border-t border-gray-100 dark:border-gray-700">
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                {new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
              </span>
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                {Math.ceil(post.body.split(/\s+/).length / 200)} min read
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Categories -->
  <section class="mb-16">
    <h2 class="text-3xl font-bold mb-8 dark:text-white flex items-center gap-2">Categories 📂</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {categories.map((cat) => (
        <a href={`/category/${cat.slug}/`} class={`group relative overflow-hidden bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-all duration-300`}>
          <div class={`absolute inset-0 bg-gradient-to-br ${cat.color} opacity-0 group-hover:opacity-10 transition-opacity duration-300`}></div>
          <div class="flex flex-col items-center text-center gap-3">
            <span class="text-4xl">{cat.emoji}</span>
            <h3 class="text-lg font-bold dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{cat.name}</h3>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Latest Posts -->
  <section class="mb-16">
    <div class="flex items-center justify-between mb-8 flex-wrap gap-4">
      <h2 class="text-3xl font-bold dark:text-white flex items-center gap-2">Latest Posts ✍️</h2>
      <a href="/blog/" class="text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline inline-flex items-center gap-1">
        Sabhi 50+ Articles Dekhein →
      </a>
    </div>
    <div class="flex flex-col gap-6">
      {latestPosts.map((post) => (
        <a href={`/blog/${post.slug}/`} class="group bg-white dark:bg-gray-800 rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 dark:border-gray-700 overflow-hidden flex flex-col sm:flex-row hover:border-blue-200 dark:hover:border-blue-900/50">
          <div class="w-full sm:w-64 h-48 sm:h-auto overflow-hidden flex-shrink-0 bg-gray-100 dark:bg-gray-800 relative">
            {(post.data.image || post.data.coverImage) ? (
              <Image src={(post.data.image || post.data.coverImage)!} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={500} height={300} />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-gray-400 dark:text-gray-500">TechVerse</div>
            )}
            <span class="sm:hidden absolute top-3 left-3 px-3 py-1 bg-black/60 backdrop-blur-md text-white text-xs font-semibold rounded-full border border-white/20">
              {categories.find(c => c.slug === post.data.category)?.name || post.data.category}
            </span>
          </div>
          <div class="p-6 flex flex-col justify-center flex-grow">
            <span class="hidden sm:inline-block px-3 py-1 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 text-xs font-semibold rounded-full mb-3 w-fit">
              {categories.find(c => c.slug === post.data.category)?.name || post.data.category}
            </span>
            <h3 class="text-xl font-bold mb-2 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug">
              {post.data.title}
            </h3>
            <p class="text-gray-600 dark:text-gray-400 line-clamp-2 mb-4 text-sm">
              {post.data.description}
            </p>
            <div class="flex items-center text-xs text-gray-500 dark:text-gray-400 mt-auto pt-2">
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                {new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </span>
              <span class="mx-2">•</span>
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                {Math.ceil(post.body.split(/\s+/).length / 200)} min read
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Explore All Blogs CTA Button -->
    <div class="mt-12 text-center">
      <a href="/blog/" class="inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 hover:from-blue-700 hover:via-indigo-700 hover:to-purple-700 text-white font-bold rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1 text-base group">
        <span>Sabhi Articles Padhein ({allPosts.length}+ Guides)</span>
        <span class="group-hover:translate-x-1.5 transition-transform duration-200 text-xl">→</span>
      </a>
    </div>
  </section>

  <!-- Newsletter -->
  <div id="newsletter" class="mb-16 scroll-mt-24">
    <NewsletterSignup />
  </div>

  <!-- Ad Banner Footer -->
  <div class="mt-12">
    <AdBanner slot='footer' />
  </div>
</BaseLayout>
