---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
const popularPosts = allPosts.slice(0, 4);
---

<BaseLayout title="404: Page Nahi Mila — TechVerse" description="Ye page mojud nahi hai ya shayad move ho chuka hai. TechVerse ke latest articles padhein.">
  <div class="max-w-4xl mx-auto px-4 py-20 text-center">
    <div class="inline-flex items-center justify-center w-24 h-24 rounded-3xl bg-blue-50 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-800 mb-8 shadow-inner">
      <span class="text-5xl">🛸</span>
    </div>

    <h1 class="text-6xl md:text-8xl font-extrabold mb-4 bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-purple-600">
      404
    </h1>
    
    <h2 class="text-2xl md:text-3xl font-bold dark:text-white mb-4">
      Oops! Ye Page Gayab Ho Gaya Hai
    </h2>

    <p class="text-gray-600 dark:text-gray-400 text-lg max-w-lg mx-auto mb-10">
      Aap jis link par aaye hain wo galat hai ya fir article ka naam badal diya gaya hai. Chaliye aapko wapas sahi raste par le chalte hain!
    </p>

    <!-- Quick Search on 404 -->
    <form action="/blog" method="GET" class="max-w-md mx-auto mb-12 relative">
      <input 
        type="text" 
        name="q"
        placeholder="🔍 Kuch aur khojein (e.g. AI, Phone, Laptops)..." 
        class="w-full px-5 py-3.5 pl-12 rounded-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-sm"
      />
      <svg class="w-5 h-5 text-gray-400 absolute left-4 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </form>

    <div class="flex flex-wrap justify-center gap-4 mb-16">
      <a href="/" class="px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold rounded-xl shadow-md hover:shadow-lg transition-all">
        ← Homepage Par Jayein
      </a>
      <a href="/blog" class="px-6 py-3 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-800 dark:text-gray-200 font-bold rounded-xl border border-gray-200 dark:border-gray-700 transition-all">
        Sabhi Blogs Dekhein →
      </a>
    </div>

    <!-- Popular Articles -->
    <div class="text-left bg-gray-50 dark:bg-gray-800/40 rounded-3xl p-8 border border-gray-200 dark:border-gray-700">
      <h3 class="text-xl font-bold dark:text-white mb-6 flex items-center gap-2">
        <span>🔥</span> Log Ye Articles Padh Rahe Hain:
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {popularPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="p-4 bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 hover:border-blue-500 dark:hover:border-blue-500 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
            <h4 class="font-bold text-gray-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors line-clamp-2 text-sm mb-2">
              {post.data.title}
            </h4>
            <span class="text-xs text-blue-600 dark:text-blue-400 font-medium">
              Padhein →
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
